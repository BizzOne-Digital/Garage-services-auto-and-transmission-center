# =============================================================================
# Garage Services Auto et Centre de Transmission — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Nothing in this file may be exposed to the browser (no VITE_ prefixes here).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# MongoDB connection string used by the API server. Never hardcoded in source.
MONGODB_URI=mongodb+srv://atifafridi378_db_user:XYFhyigspapZBxCW@cluster0.lkcyikf.mongodb.net/
# Optional: database name when it is not already part of MONGODB_URI.
MONGODB_DB_NAME=Garage

# -----------------------------------------------------------------------------
# Admin authentication (required)
# -----------------------------------------------------------------------------
# Bootstrap admin account. Created on first `npm run seed` / first API start.
# Changing ADMIN_PASSWORD later does NOT rotate the stored password — use the
# "Change password" form in /admin/settings instead.
ADMIN_EMAIL=AbdulAdmin@gmail.com
ADMIN_PASSWORD=Abdul123!
# Display name shown in the admin header.
ADMIN_NAME=Administrator
# Secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=trong123456789@!
# How long an admin stays signed in, in days.
SESSION_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Server (optional)
# -----------------------------------------------------------------------------
# Port for the Express API. The Vite dev server proxies /api to this port.
PORT=4000
# Set to `production` to make the API also serve the built site from ./dist.
NODE_ENV=development
# Public URL of the website (used for canonical/self-referential links).
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Cloudinary media uploads (optional)
# -----------------------------------------------------------------------------
# Only needed if you want to upload files from the admin Media library.
# Without these, the Media library still works — you add assets by URL.
CLOUDINARY_CLOUD_NAME=dobtsjhb2
CLOUDINARY_API_KEY=962162177873315
CLOUDINARY_API_SECRET=6pI4O3BS79mSFG3p4002YfWekTg

# Folder that uploaded assets are stored under.
# CLOUDINARY_FOLDER=garage-services

# -----------------------------------------------------------------------------
# Legacy (pre-existing, unrelated to the admin portal)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: injected by AI Studio at runtime when the applet is hosted there.
GEMINI_API_KEY=
# APP_URL: injected by AI Studio with the Cloud Run service URL.
APP_URL=
